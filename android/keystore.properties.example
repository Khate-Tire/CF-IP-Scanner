# Copy this file to `keystore.properties` (git-ignored) and fill in the values.
# `storeFile` is resolved relative to the `android/` directory.
#
# To generate a fresh keystore: `pwsh ./scripts/generate-release-keystore.ps1`
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=khatetire-release
keyPassword=CHANGE_ME
