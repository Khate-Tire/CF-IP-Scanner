# Database Configuration — copy this to .env and fill in your values
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_PORT=3306

# Admin Panel URL (for Play Freedom & config fetching)
ADMIN_API_URL=https://your-admin-panel-url

# Cloudflare Worker proxy
WORKER_URL=https://your-worker-url.workers.dev
WORKER_API_KEY=your-worker-api-key

# Frontend (VITE_ prefix makes them available to the React app)
VITE_FALLBACK_CONFIG=vless://your-fallback-config-here
VITE_AUTO_SUB_URL=https://your-subscription-url-here
